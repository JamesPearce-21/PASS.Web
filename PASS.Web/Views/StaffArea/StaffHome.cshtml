@{
    ViewData["Title"] = "Staff Home";
    bool isAdmin = ViewBag.IsAdmin ?? false;
    string username = ViewBag.Username ?? "";
}

@section Styles {
        <link rel="stylesheet" href="~/css/StaffArea.css" asp-append-version="true" />
}

@inject PASS.Web.Services.ContentService Content

<section class="staff-home-section">
    <h1>Welcome, @username</h1>

    <!-- Documents Section (both Staff & Admin) -->
    <div class="staff-section documents-section">
        <h2>Documents</h2>
        <p>Access all staff documents here.</p>
        <ul>
            <li><a href="/Assets/Documents/PASS Staff Audit 25-26.docx" target="_blank">PASS Staff Audit 25-26</a></li>
            <li><a href="/Assets/Documents/PASS STAFF INFORMATION 2025-26.docx" target="_blank">PASS STAFF INFORMATION 2025-26</a></li>
            <li><a href="/Assets/Documents/PASS UKS2 - Play Leadership.pdf" target="_blank">PASS UKS2 - Play Leadership</a></li>
        </ul>
    </div>

    <!-- Information Section (both Staff & Admin) -->
    <div class="staff-section info-section">
        <h2>Information</h2>
        <p>General staff information and announcements.</p>
    </div>

    @if (isAdmin)
    {
        <!-- Admin-only Balanceability Editor -->
        <div class="staff-section admin-section">
            <h2>Edit Balanceability Content</h2>

            <form id="balanceabilityForm">
                <div class="admin-editor">
                    <div class="form-group">
                        <label>Heading</label>
                        <input type="text" name="Heading" value="@Content.Get("Balanceability:Sections:0:TextContent:0:Heading")" />
                    </div>

                    <div class="form-group">
                        <label>Paragraph 1</label>
                        <textarea name="Paragraph1">@Content.Get("Balanceability:Sections:0:TextContent:1:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 2</label>
                        <textarea name="Paragraph2">@Content.Get("Balanceability:Sections:0:TextContent:2:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 3</label>
                        <textarea name="Paragraph3">@Content.Get("Balanceability:Sections:0:TextContent:3:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 4</label>
                        <textarea name="Paragraph4">@Content.Get("Balanceability:Sections:0:TextContent:4:Paragraph")</textarea>
                    </div>

                    <div class="form-group" style="display: none;">
                        <label>Current Image Src</label>
                        <input type="text" id="imageSrc" name="ImageSrc" value="@Content.Get("Balanceability:Sections:0:ImageContent:0:Src")" readonly />
                    </div>

                    <div class="form-group">
                        <label>Current Image Preview</label>
                        <img id="imagePreview" src="@Content.Get("Balanceability:Sections:0:ImageContent:0:Src")"
                             alt="@Content.Get("Balanceability:Sections:0:ImageContent:0:Alt")" />
                    </div>


                    <div class="form-group">
                        <label>Upload New Image</label>
                        <input type="file" id="imageFile" name="ImageFile" accept="image/*" />
                    </div>

                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>

            </form>

            <div id="successMessage" style="display:none;color:green;margin-top:10px;"></div>
        </div>

        <!-- Admin-only Bikeability Editor -->
        <div class="staff-section admin-section">
            <h2>Edit Bikeability Content</h2>

            <form id="bikeabilityForm">
                <div class="admin-editor">
                    <div class="form-group">
                        <label>Heading</label>
                        <input type="text" name="Heading" value="@Content.Get("Bikeability:Sections:0:TextContent:0:Heading")" />
                    </div>

                    <div class="form-group">
                        <label>Paragraph 1</label>
                        <textarea name="Paragraph1">@Content.Get("Bikeability:Sections:0:TextContent:1:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 2</label>
                        <textarea name="Paragraph2">@Content.Get("Bikeability:Sections:0:TextContent:2:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 3</label>
                        <textarea name="Paragraph3">@Content.Get("Bikeability:Sections:0:TextContent:3:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>List Item 1</label>
                        <textarea name="ListItem1">@Content.Get("Bikeability:Sections:0:TextContent:4:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>List Item 2</label>
                        <textarea name="ListItem2">@Content.Get("Bikeability:Sections:0:TextContent:5:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>List Item 3</label>
                        <textarea name="ListItem3">@Content.Get("Bikeability:Sections:0:TextContent:6:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 4</label>
                        <textarea name="Paragraph4">@Content.Get("Bikeability:Sections:0:TextContent:7:Paragraph")</textarea>
                    </div>

                    <div class="form-group" style="display: none;">
                        <label>Current Image Src</label>
                        <input type="text" id="imageSrcBike" name="ImageSrc" value="@Content.Get("Bikeability:Sections:0:ImageContent:0:Src")" readonly />
                    </div>

                    <div class="form-group">
                        <label>Current Image Preview</label>
                        <img id="imagePreviewBike" src="@Content.Get("Bikeability:Sections:0:ImageContent:0:Src")"
                             alt="@Content.Get("Bikeability:Sections:0:ImageContent:0:Alt")" />
                    </div>

                    <div class="form-group">
                        <label>Upload New Image</label>
                        <input type="file" id="imageFileBike" name="ImageFile" accept="image/*" />
                    </div>

                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>

            <div id="successMessageBike" style="display:none;color:green;margin-top:10px;"></div>
        </div>

    }

    <a href="/StaffArea/Logout">Logout</a>
</section>

@section Scripts {
    <script>
        document.getElementById("balanceabilityForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            const response = await fetch('@Url.Action("SaveBalanceability", "StaffArea")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();
            if (result.success) {
                const msgDiv = document.getElementById("successMessage");
                msgDiv.innerText = result.message;
                msgDiv.style.display = "block";

                // Hide after 3 seconds
                setTimeout(() => msgDiv.style.display = "none", 3000);
            } else {
                alert(result.message);
            }
        });
    </script>
    <script>
        document.getElementById("bikeabilityForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            const response = await fetch('@Url.Action("SaveBikeability", "StaffArea")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();
            if (result.success) {
                const msgDiv = document.getElementById("successMessageBike");
                msgDiv.innerText = result.message;
                msgDiv.style.display = "block";

                // Hide after 3 seconds
                setTimeout(() => msgDiv.style.display = "none", 3000);
            } else {
                alert(result.message);
            }
        });
    </script>

    <script>
        document.getElementById("imageFile").addEventListener("change", async function () {
            const file = this.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append("file", file);

            try {
                const res = await fetch('/StaffArea/UploadImage', {
                    method: 'POST',
                    body: formData
                });

                const data = await res.json();
                if (data.success) {
                    // Update the ImageSrc textbox so it gets saved later
                    document.getElementById("imageSrc").value = data.url;

                    // Update the image preview
                    const preview = document.getElementById("imagePreview");
                    preview.src = data.url;

                    alert("Image uploaded successfully!");
                } else {
                    alert("Upload failed: " + data.message);
                }
            } catch (err) {
                console.error(err);
                alert("An error occurred during upload.");
            }
        });
    </script>
    <script>
        document.getElementById("imageFileBike").addEventListener("change", async function () {
            const file = this.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append("file", file);

            try {
                const res = await fetch('/StaffArea/UploadBikeabilityImage', {
                    method: 'POST',
                    body: formData
                });

                const data = await res.json();
                if (data.success) {
                    // Update the hidden ImageSrc textbox
                    document.getElementById("imageSrcBike").value = data.url;

                    // Update the image preview
                    const preview = document.getElementById("imagePreviewBike");
                    preview.src = data.url;

                    alert("Bikeability image uploaded successfully!");
                } else {
                    alert("Upload failed: " + data.message);
                }
            } catch (err) {
                console.error(err);
                alert("An error occurred during upload.");
            }
        });
    </script>

}
