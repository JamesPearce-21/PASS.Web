@{
    ViewData["Title"] = "Staff Home";
    bool isAdmin = ViewBag.IsAdmin ?? false;
    string username = ViewBag.Username ?? "";
}

@section Styles {
        <link rel="stylesheet" href="~/css/StaffArea.css" asp-append-version="true" />
}

@inject PASS.Web.Services.ContentService Content

<section class="staff-home-section">
    <h1>Welcome, @username</h1>

    <!-- Documents Section (both Staff & Admin) -->
    <div class="staff-section documents-section">
        <h2>Documents</h2>
        <p>Access all staff documents here.</p>
        <ul>
            <li><a href="/Assets/Documents/PASS Staff Audit 25-26.docx" target="_blank">PASS Staff Audit 25-26</a></li>
            <li><a href="/Assets/Documents/PASS STAFF INFORMATION 2025-26.docx" target="_blank">PASS STAFF INFORMATION 2025-26</a></li>
            <li><a href="/Assets/Documents/PASS UKS2 - Play Leadership.pdf" target="_blank">PASS UKS2 - Play Leadership</a></li>
        </ul>
    </div>

    <!-- Information Section (both Staff & Admin) -->
    <div class="staff-section info-section">
        <h2>Information</h2>
        <p>General staff information and announcements.</p>
    </div>

    @if (isAdmin)
    {
        @Html.Partial("_SectionEditor", new SectionEditorModel
        {
            Title = "Balanceability",
            SectionKey = "Balanceability",
            ParagraphCount = 4,
            SectionWrapper = Content.GetWrapper("Balanceability")
        })
        
                @Html.Partial("_SectionEditor", new SectionEditorModel
        {
            Title = "Bikeability",
            SectionKey = "Bikeability",
            ParagraphCount = 8,
            SectionWrapper = Content.GetWrapper("Bikeability")
        })
    }


    <a href="/StaffArea/Logout">Logout</a>
</section>

@section Scripts {
    <script>
        document.querySelectorAll('.sectionForm').forEach(form => {
            const sectionKey = form.dataset.section;
            const msgDiv = form.closest('.admin-section-editor').querySelector('.saveMessage');

            form.addEventListener('submit', async e => {
                e.preventDefault();

                const wrapper = { Sections: [{ TextContent: [], ImageContent: [] }] };

                // Map TextContent
                form.querySelectorAll("input[name^='TextContent'], textarea[name^='TextContent']").forEach(input => {
                    const match = input.name.match(/TextContent\[(\d+)\]\.(Heading|Paragraph)/);
                    if (!match) return;
                    const index = parseInt(match[1]);
                    const prop = match[2];
                    wrapper.Sections[0].TextContent[index] = wrapper.Sections[0].TextContent[index] || { Heading: "", Paragraph: "" };
                    wrapper.Sections[0].TextContent[index][prop] = input.value;
                });

                // Map ImageContent
                form.querySelectorAll("input[name^='ImageContent']").forEach(input => {
                    const match = input.name.match(/ImageContent\[(\d+)\]\.(Src|Alt)/);
                    if (!match) return;
                    const index = parseInt(match[1]);
                    const prop = match[2];

                    // Ensure the object exists
                    wrapper.Sections[0].ImageContent[index] = wrapper.Sections[0].ImageContent[index] || {};

                    // Only set if the value is not empty (preserve existing Src)
                    if (input.value) {
                        wrapper.Sections[0].ImageContent[index][prop] = input.value;
                    }
                });

                const res = await fetch(`/StaffArea/SaveSection?sectionKey=${sectionKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(wrapper)
                });

                const data = await res.json();
                msgDiv.innerText = data.message;
                msgDiv.style.display = 'block';
                setTimeout(() => msgDiv.style.display = 'none', 3000);
            });
        });
    </script>
}
