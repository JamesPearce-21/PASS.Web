    <script>
        // Upload new document
        document.getElementById("documentFileStaff")?.addEventListener("change", async function () {
            const file = this.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append("file", file);

            try {
                const res = await fetch('/StaffArea/UploadStaffDocument', {
                    method: 'POST',
                    body: formData
                });

                const data = await res.json();
                if (data.success) {
                    const list = document.getElementById("documentsList");
                    const index = list.children.length;
                    const div = document.createElement("div");
                    div.className = "document-item";
                    div.dataset.index = index;
                    div.innerHTML = `
                            <input type="text" name="DocSrc_${index}" value="${data.url}" readonly />
                            <input type="text" name="DocAlt_${index}" value="${file.name}" />
                            <button type="button" class="remove-document-btn">Remove</button>
                        `;
                    list.appendChild(div);
                } else {
                    alert("Upload failed: " + data.message);
                }
            } catch (err) {
                console.error(err);
                alert("Error uploading document.");
            }
        });

        // Remove document
        document.getElementById("documentsList")?.addEventListener("click", function (e) {
            if (e.target.classList.contains("remove-document-btn")) {
                e.target.parentElement.remove();
            }
        });

        // Save documents
        document.getElementById("documentsForm")?.addEventListener("submit", async function (e) {
            e.preventDefault();
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            const response = await fetch('@Url.Action("SaveStaffDocuments", "StaffArea")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();
            if (result.success) {
                alert(result.message);
            } else {
                alert(result.message);
            }
        });

        // Save info paragraph
        document.getElementById("staffInfoForm").addEventListener("submit", async function (e) {
            e.preventDefault();
            const paragraph = document.getElementById("staffInfoParagraph").value;

            try {
                const response = await fetch('/StaffArea/SaveStaffInfo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ paragraph })
                });

                const result = await response.json();
                if (result.success) {
                    alert(result.message);
                } else {
                    alert(result.message);
                }
            } catch (err) {
                console.error(err);
                alert("An error occurred while saving.");
            }
        });


    </script>


