@section Scripts {
    <script>
        // ===============================
        // Image Upload
        // ===============================
        document.getElementById("heroImageFile").addEventListener("change", async function () {
            const file = this.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append("file", file);

            try {
                const res = await fetch('/StaffArea/UploadHeroImage', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) {
                    document.getElementById("heroImageSrc").value = data.url;
                    document.getElementById("heroImagePreview").src = data.url;
                    alert("Image uploaded successfully!");
                } else {
                    alert("Upload failed: " + data.message);
                }
            } catch (err) {
                console.error(err);
                alert("An error occurred during upload.");
            }
        });

        // ===============================
        // Dynamic Add/Remove Handler
        // ===============================
        function dynamicAddRemove(containerId, addBtnId, groupClass, templateHtml) {
            // Add new item
            document.getElementById(addBtnId).addEventListener('click', () => {
                const container = document.getElementById(containerId);
                const index = container.querySelectorAll(`.${groupClass}`).length;
                const div = document.createElement('div');
                div.className = `form-group ${groupClass}`;
                div.dataset.index = index;
                div.innerHTML = templateHtml(index);
                container.appendChild(div);
            });

            // Remove item
            document.addEventListener('click', (e) => {
                if (e.target && e.target.classList.contains(`remove-${groupClass.replace('-group', '')}`)) {
                    e.target.closest(`.${groupClass}`).remove();
                }
            });
        }

        // Templates for dynamic groups
        const templates = {
            course: index => `
                    <h4>Course ${index}</h4>
                    <label>Icon</label><input type="text" name="CourseIcon_${index}" />
                    <label>Heading</label><input type="text" name="CourseHeading_${index}" />
                    <label>Paragraph</label><textarea name="CourseParagraph_${index}"></textarea>
                    <label>Link URL</label><input type="text" name="CourseLinkUrl_${index}" />
                    <label>Link Text</label><input type="text" name="CourseLinkText_${index}" />
                    <button type="button" class="btn btn-danger remove-course" style="margin-top:5px;">Remove Course</button>
                `,
            stat: index => `
                    <label>Value</label><input type="text" name="StatValue_${index}" />
                    <label>Label</label><input type="text" name="StatLabel_${index}" />
                    <button type="button" class="btn btn-danger remove-stat" style="margin-top:5px;">Remove Stat</button>
                `,
            testimonial: index => `
                    <label>Quote</label><textarea name="TestQuote_${index}"></textarea>
                    <label>Author</label><input type="text" name="TestAuthor_${index}" />
                    <button type="button" class="btn btn-danger remove-testimonial" style="margin-top:5px;">Remove Testimonial</button>
                `,
            school: index => `
                    <label>School</label><input type="text" name="School_${index}" />
                    <button type="button" class="btn btn-danger remove-school" style="margin-top:5px;">Remove School</button>
                `,
            credential: index => `
                    <label>Credential</label><input type="text" name="Credential_${index}" />
                    <button type="button" class="btn btn-danger remove-credential" style="margin-top:5px;">Remove Credential</button>
                `
        };

        // Initialize dynamic handlers
        dynamicAddRemove('courseGridContainer', 'addCourse', 'course-group', templates.course);
        dynamicAddRemove('impactStatsContainer', 'addStat', 'stat-group', templates.stat);
        dynamicAddRemove('testimonialsContainer', 'addTestimonial', 'testimonial-group', templates.testimonial);
        dynamicAddRemove('membershipSchoolsContainer', 'addSchool', 'school-group', templates.school);
        dynamicAddRemove('membershipCredentialsContainer', 'addCredential', 'credential-group', templates.credential);

        // ===============================
        // Form Submission
        // ===============================
        document.getElementById("heroForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            // Collect dynamic arrays
            data.CourseGrid = [];
            const courseEls = document.querySelectorAll('.course-group');
            courseEls.forEach((el, i) => {
                data.CourseGrid.push({
                    Icon: el.querySelector(`[name="CourseIcon_${i}"]`)?.value || "",
                    Heading: el.querySelector(`[name="CourseHeading_${i}"]`)?.value || "",
                    Paragraph: el.querySelector(`[name="CourseParagraph_${i}"]`)?.value || "",
                    LinkUrl: el.querySelector(`[name="CourseLinkUrl_${i}"]`)?.value || "",
                    LinkText: el.querySelector(`[name="CourseLinkText_${i}"]`)?.value || ""
                });
            });

            data.ImpactStats = [];
            const statEls = document.querySelectorAll('.stat-group');
            statEls.forEach((el, i) => {
                data.ImpactStats.push({
                    Value: el.querySelector(`[name="StatValue_${i}"]`)?.value || "",
                    Label: el.querySelector(`[name="StatLabel_${i}"]`)?.value || ""
                });
            });

            data.Testimonials = [];
            const testEls = document.querySelectorAll('.testimonial-group');
            testEls.forEach((el, i) => {
                data.Testimonials.push({
                    Quote: el.querySelector(`[name="TestQuote_${i}"]`)?.value || "",
                    Author: el.querySelector(`[name="TestAuthor_${i}"]`)?.value || ""
                });
            });

            // Schools & Credentials
            data.MembershipSchools = [];
            document.querySelectorAll('[name^="School_"]').forEach(el => {
                if (el.value.trim()) data.MembershipSchools.push(el.value.trim());
            });

            data.MembershipCredentials = [];
            document.querySelectorAll('[name^="Credential_"]').forEach(el => {
                if (el.value.trim()) data.MembershipCredentials.push(el.value.trim());
            });

            // Send to server
            const response = await fetch('@Url.Action("SaveHero", "StaffArea")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();
            const msgDiv = document.getElementById("successMessageHero");

            if (result.success) {
                msgDiv.innerText = result.message;
                msgDiv.style.display = "block";
                setTimeout(() => msgDiv.style.display = "none", 3000);
            } else {
                alert(result.message);
            }
        });
    </script>


    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // --- Helpers ---
            function createDocumentNode(yearIndex, title = "", url = "") {
                const wrapper = document.createElement("div");
                wrapper.className = "form-group document-group";
                wrapper.innerHTML = `
                    <label>Document Title</label>
                    <input type="text" class="doc-title" value="${escapeHtml(title)}" />

                    <label>Current Document</label>
                    <p class="doc-link">${url ? `<a href="${escapeAttr(url)}" target="_blank">${escapeHtml(url)}</a>` : ""}</p>
                    <input type="hidden" class="doc-url" value="${escapeAttr(url)}" />

                    <label>Upload / Replace Document</label>
                    <input type="file" class="upload-doc" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt" />

                    <button type="button" class="btn btn-danger remove-document">Remove</button>
                `;
                return wrapper;
            }

            function escapeHtml(s) {
                if (!s) return "";
                return s.replace(/[&<>"']/g, function (m) {
                    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m];
                });
            }
            function escapeAttr(s) { return escapeHtml(s); }

            // Attach add-document handlers
            document.querySelectorAll(".add-document").forEach(btn => {
                btn.addEventListener("click", () => {
                    const yearIndex = btn.getAttribute("data-year");
                    const container = document.getElementById("documentsContainer_" + yearIndex);
                    const node = createDocumentNode(yearIndex, "", "");
                    container.appendChild(node);

                    // wire up upload handler for this new node
                    const uploadInput = node.querySelector(".upload-doc");
                    uploadInput.addEventListener("change", handleUploadChange);

                    // remove button is delegated globally (see below)
                });
            });

            // Delegated remove-document handler
            document.addEventListener("click", (e) => {
                if (e.target.classList.contains("remove-document")) {
                    const node = e.target.closest(".document-group");
                    if (node) node.remove();
                }
            });

            // Upload-on-change handler (for existing and dynamically added inputs)
            async function handleUploadChange(e) {
                const input = e.target;
                const file = input.files[0];
                if (!file) return;

                // Small UI feedback
                const container = input.closest(".document-group");
                const linkP = container.querySelector(".doc-link");
                const urlHidden = container.querySelector(".doc-url");

                try {
                    const fd = new FormData();
                    fd.append("file", file);

                    const res = await fetch('/StaffArea/UploadMembersDocument', {
                        method: 'POST',
                        body: fd
                    });

                    const data = await res.json();
                    if (data.success && data.url) {
                        urlHidden.value = data.url;
                        linkP.innerHTML = `<a href="${escapeAttr(data.url)}" target="_blank">${escapeHtml(data.url)}</a>`;
                        alert("File uploaded successfully");
                    } else {
                        alert("Upload failed: " + (data.message || "unknown error"));
                    }
                } catch (err) {
                    console.error(err);
                    alert("An error occurred during upload");
                }
            }

            // Attach upload handler to existing file inputs
            document.querySelectorAll(".upload-doc").forEach(input => {
                input.addEventListener("change", handleUploadChange);
            });

            // Build JSON from DOM and POST to SaveMembersArea
            document.getElementById("saveMembersArea").addEventListener("click", async () => {
                const payload = {
                    Intro: {
                        Heading: document.querySelector('[name="IntroHeading"]').value || "",
                        Paragraph: document.querySelector('[name="IntroParagraph"]').value || ""
                    },
                    Schemes: []
                };

                document.querySelectorAll(".year-group-admin").forEach((yg) => {
                    const yearGroup = (yg.querySelector(".yeargroup-name") || {}).value || "";
                    const scheme = { YearGroup: yearGroup, Documents: [] };

                    yg.querySelectorAll(".document-group").forEach((doc) => {
                        const title = (doc.querySelector(".doc-title") || {}).value || "";
                        const url = (doc.querySelector(".doc-url") || {}).value || "";
                        // Only include documents that have a title OR a URL (you can adjust)
                        if (title.trim() || url.trim()) {
                            scheme.Documents.push({ Title: title.trim(), Url: url.trim() });
                        }
                    });

                    payload.Schemes.push(scheme);
                });

                // send JSON to server
                try {
                    const res = await fetch('/StaffArea/SaveMembersArea', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    const data = await res.json();
                    if (data.success) {
                        const msg = document.getElementById("successMessageMembers");
                        msg.innerText = data.message || "Saved";
                        msg.style.display = "block";
                        setTimeout(() => msg.style.display = "none", 3000);
                    } else {
                        alert("Save failed: " + (data.message || "unknown"));
                    }
                } catch (err) {
                    console.error(err);
                    alert("An error occurred while saving.");
                }
            });
        });

    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const container = document.getElementById("teamMembersContainer");
            const addBtn = document.getElementById("addTeamMember");
            const form = document.getElementById("teamForm");

            // Function to update input names after add/remove
            function updateMemberIndices() {
                container.querySelectorAll(".team-member-group").forEach((div, index) => {
                    div.querySelector('input[name^="Members"]').name = `Members[${index}].Heading`;
                    div.querySelector('textarea[name^="Members"]').name = `Members[${index}].Paragraph`;
                });
            }

            // Add new team member dynamically
            addBtn.addEventListener("click", () => {
                const div = document.createElement("div");
                div.className = "form-group team-member-group";
                div.innerHTML = `
                    <label>Team Member Name</label>
                    <input type="text" name="Members[].Heading" value="" />

                    <label>Job Title & Description</label>
                    <textarea name="Members[].Paragraph"></textarea>

                    <button type="button" class="btn btn-danger remove-member">Remove</button>
                `;

                container.appendChild(div);
                updateMemberIndices();
            });

            // Remove team member
            container.addEventListener("click", (e) => {
                if (e.target.classList.contains("remove-member")) {
                    e.target.closest(".team-member-group").remove();
                    updateMemberIndices();
                }
            });

            // Handle form submission
            form.addEventListener("submit", async (e) => {
                e.preventDefault();

                const members = [];
                container.querySelectorAll(".team-member-group").forEach((div) => {
                    const headingInput = div.querySelector('input[name^="Members"]');
                    const paragraphInput = div.querySelector('textarea[name^="Members"]');
                    if (!headingInput || !paragraphInput) return;

                    members.push({
                        Heading: headingInput.value.trim(),
                        Paragraph: paragraphInput.value.trim()
                    });
                });

                if (!members.length) {
                    alert("Please add at least one team member before saving.");
                    return;
                }

                try {
                    const response = await fetch('@Url.Action("SaveTheTeam", "StaffArea")', {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ Members: members })
                    });

                    const result = await response.json();

                    if (result.success) {
                        const msgDiv = document.getElementById("successMessageTeam");
                        msgDiv.innerText = result.message;
                        msgDiv.style.display = "block";
                        setTimeout(() => (msgDiv.style.display = "none"), 3000);
                    } else {
                        alert(result.message);
                    }
                } catch (err) {
                    console.error(err);
                    alert("An error occurred during submission.");
                }
            });
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const container = document.getElementById("eventsContainer");
            const addBtn = document.getElementById("addEvent");
            const form = document.getElementById("eventsForm");

            function updateIndices() {
                container.querySelectorAll(".event-group").forEach((div, index) => {
                    div.querySelector('input[name^="Events"][name$=".Heading"]').name = `Events[${index}].Heading`;
                    div.querySelector('textarea[name^="Events"][name$=".Paragraph"]').name = `Events[${index}].Paragraph`;
                    div.querySelector('select[name^="Events"][name$=".Status"]').name = `Events[${index}].Status`;
                    div.querySelector('input[name^="Events"][name$=".BookingUrl"]').name = `Events[${index}].BookingUrl`;
                    div.querySelector('input[name^="Events"][name$=".StartDate"]').name = `Events[${index}].StartDate`;
                    div.querySelector('input[name^="Events"][name$=".EndDate"]').name = `Events[${index}].EndDate`;
                });
            }

            addBtn.addEventListener("click", () => {
                const div = document.createElement("div");
                div.className = "form-group event-group";
                div.innerHTML = `
                        <label>Event Heading</label>
                        <input type="text" name="Events[].Heading" value="" />

                        <label>Description</label>
                        <textarea name="Events[].Paragraph"></textarea>

                        <label>Status</label>
                        <select name="Events[].Status">
                            <option value="Coming Soon">Coming Soon</option>
                            <option value="Open">Open</option>
                            <option value="Closed">Closed</option>
                        </select>

                        <label>Booking URL</label>
                        <input type="text" name="Events[].BookingUrl" value="" />

                        <div class="date-range-box">
                            <label>Start Date:</label>
                            <input type="date" name="Events[].StartDate" class="date-range-input" />

                            <label>End Date:</label>
                            <input type="date" name="Events[].EndDate" class="date-range-input" />
                        </div>

                        <button type="button" class="btn btn-danger remove-event" style="margin-top:5px;">Remove</button>
                        <hr />
                    `;
                container.appendChild(div);
                updateIndices();
            });

            container.addEventListener("click", (e) => {
                if (e.target.classList.contains("remove-event")) {
                    e.target.closest(".event-group").remove();
                    updateIndices();
                }
            });

            // Submit form
            form.addEventListener("submit", async (e) => {
                e.preventDefault();

                const events = [];
                container.querySelectorAll(".event-group").forEach(div => {
                    const heading = div.querySelector('input[name$=".Heading"]')?.value.trim() || "";
                    const paragraph = div.querySelector('textarea[name$=".Paragraph"]')?.value.trim() || "";
                    const status = div.querySelector('select[name$=".Status"]')?.value || "";
                    const bookingUrl = div.querySelector('input[name$=".BookingUrl"]')?.value.trim() || "";
                    const startDate = div.querySelector('input[name$=".StartDate"]')?.value || "";
                    const endDate = div.querySelector('input[name$=".EndDate"]')?.value || "";

                    events.push({
                        Heading: heading,
                        Paragraph: paragraph,
                        Status: status,
                        BookingUrl: bookingUrl,
                        StartDate: startDate,
                        EndDate: endDate
                    });
                });

                try {
                    const response = await fetch('@Url.Action("SaveEvents", "StaffArea")', {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ Events: events })
                    });

                    const result = await response.json();
                    if (result.success) {
                        const msgDiv = document.getElementById("successMessageEvents");
                        msgDiv.innerText = result.message;
                        msgDiv.style.display = "block";
                        setTimeout(() => (msgDiv.style.display = "none"), 3000);
                    } else {
                        alert(result.message);
                    }
                } catch (err) {
                    console.error(err);
                    alert("An error occurred during submission.");
                }
            });
        });
    </script>




