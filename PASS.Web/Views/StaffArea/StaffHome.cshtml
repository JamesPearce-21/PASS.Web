@{
    ViewData["Title"] = "Staff Home";
    bool isAdmin = ViewBag.IsAdmin ?? false;
    string username = ViewBag.Username ?? "";
}

@section Styles {
        <link rel="stylesheet" href="~/css/StaffArea.css" asp-append-version="true" />
}

@inject PASS.Web.Services.ContentService Content

<section class="staff-home-section">

    <!-- Documents Section (both Staff & Admin) -->
    <h1>Welcome, @username</h1>

    <!-- Documents Section -->
    <div class="staff-section documents-section">
        <h2>Documents</h2>

        @if (isAdmin)
        {
            <form id="documentsForm">
                <div id="documentsList">
                    @{
                        var d = 0;
                        // Loop until we hit an empty/null Src
                        while (!string.IsNullOrEmpty(Content.Get($"StaffDocs:Sections:0:Documents:{d}:Src")))
                        {
                            <div class="document-item" data-index="@d">
                                <input type="text" name="DocSrc_@d"
                                       value="@Content.Get($"StaffDocs:Sections:0:Documents:{d}:Src")" readonly />

                                <input type="text" name="DocAlt_@d"
                                       value="@Content.Get($"StaffDocs:Sections:0:Documents:{d}:Alt")" />

                                <button type="button" class="remove-document-btn">Remove</button>
                            </div>
                            ;

                            d++;
                        }
                    }
                </div>

                <div class="form-group">
                    <label>Upload New Document</label>
                    <input type="file" id="documentFileStaff" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt" />
                </div>

                <button type="submit" class="btn btn-primary">Save Documents</button>
            </form>
        }
        else
        {
            <ul>
                @{
                    var d = 0;
                    while (!string.IsNullOrEmpty(Content.Get($"StaffDocs:Sections:0:Documents:{d}:Src")))
                    {
                        <li>
                            <a href="@Content.Get($"StaffDocs:Sections:0:Documents:{d}:Src")" target="_blank">
                                @Content.Get($"StaffDocs:Sections:0:Documents:{d}:Alt")
                            </a>
                        </li>
                        ;

                        d++;
                    }
                }
            </ul>
        }
    </div>

    @if (isAdmin)
    {
        <!-- Admin-only Balanceability Editor -->
        <div class="staff-section admin-section">
            <h2>Edit Balanceability Content</h2>

            <form id="balanceabilityForm">
                <div class="admin-editor">
                    <div class="form-group">
                        <label>Heading</label>
                        <input type="text" name="Heading" value="@Content.Get("Balanceability:Sections:0:TextContent:0:Heading")" />
                    </div>

                    <div class="form-group">
                        <label>Paragraph 1</label>
                        <textarea name="Paragraph1">@Content.Get("Balanceability:Sections:0:TextContent:1:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 2</label>
