@{
    ViewData["Title"] = "Staff Home";
    bool isAdmin = ViewBag.IsAdmin ?? false;
    string username = ViewBag.Username ?? "";
}

@section Styles {
        <link rel="stylesheet" href="~/css/StaffArea.css" asp-append-version="true" />
}

@inject PASS.Web.Services.ContentService Content

<section class="staff-home-section">

    <!-- Documents Section (both Staff & Admin) -->
    <h1>Welcome, @username</h1>

    <!-- Documents Section -->
    <div class="staff-section documents-section">
        <h2>Documents</h2>

        @if (isAdmin)
        {
            <form id="documentsForm">
                <div id="documentsList">
                    @{
                        var d = 0;
                        // Loop until we hit an empty/null Src
                        while (!string.IsNullOrEmpty(Content.Get($"StaffDocs:Sections:0:Documents:{d}:Src")))
                        {
                            <div class="document-item" data-index="@d">
                                <input type="text" name="DocSrc_@d"
                                       value="@Content.Get($"StaffDocs:Sections:0:Documents:{d}:Src")" readonly />

                                <input type="text" name="DocAlt_@d"
                                       value="@Content.Get($"StaffDocs:Sections:0:Documents:{d}:Alt")" />

                                <button type="button" class="remove-document-btn">Remove</button>
                            </div>
                            ;

                            d++;
                        }
                    }
                </div>

                <div class="form-group">
                    <label>Upload New Document</label>
                    <input type="file" id="documentFileStaff" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt" />
                </div>

                <button type="submit" class="btn btn-primary">Save Documents</button>
            </form>
        }
        else
        {
            <ul>
                @{
                    var d = 0;
                    while (!string.IsNullOrEmpty(Content.Get($"StaffDocs:Sections:0:Documents:{d}:Src")))
                    {
                        <li>
                            <a href="@Content.Get($"StaffDocs:Sections:0:Documents:{d}:Src")" target="_blank">
                                @Content.Get($"StaffDocs:Sections:0:Documents:{d}:Alt")
                            </a>
                        </li>
                        ;

                        d++;
                    }
                }
            </ul>
        }
    </div>

    @if (isAdmin)
    {

        <div class="staff-section admin-section">
            <h2>Change User Password</h2>
            <form id="changePasswordForm">
                <div class="form-group">
                    <label>Username</label>
                    <input type="text" id="username" required />
                </div>
                <div class="form-group">
                    <label>New Password</label>
                    <input type="password" id="newPassword" required />
                </div>
                <button type="submit" class="btn btn-primary">Update Password</button>
            </form>
            <div id="passwordChangeMessage" style="margin-top:10px;"></div>
        </div>

        <script>
            document.getElementById("changePasswordForm").addEventListener("submit", async (e) => {
                e.preventDefault();

                const username = document.getElementById("username").value.trim();
                const newPassword = document.getElementById("newPassword").value.trim();

                const response = await fetch('@Url.Action("ChangeUserPassword", "StaffArea")', {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ Username: username, NewPassword: newPassword })
                });

                const result = await response.json();
                const msg = document.getElementById("passwordChangeMessage");
                msg.innerText = result.message;
                msg.style.color = result.success ? "green" : "red";
            });
        </script>

        <!-- Admin-only Balanceability Editor -->
        <div class="staff-section admin-section">
            <h2>Edit Balanceability Content</h2>

            <form id="balanceabilityForm">
                <div class="admin-editor">
                    <div class="form-group">
                        <label>Heading</label>
                        <input type="text" name="Heading" value="@Content.Get("Balanceability:Sections:0:TextContent:0:Heading")" />
                    </div>

                    <div class="form-group">
                        <label>Paragraph 1</label>
                        <textarea name="Paragraph1">@Content.Get("Balanceability:Sections:0:TextContent:1:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 2</label>
                        <textarea name="Paragraph2">@Content.Get("Balanceability:Sections:0:TextContent:2:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 3</label>
                        <textarea name="Paragraph3">@Content.Get("Balanceability:Sections:0:TextContent:3:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 4</label>
                        <textarea name="Paragraph4">@Content.Get("Balanceability:Sections:0:TextContent:4:Paragraph")</textarea>
                    </div>

                    <div class="form-group" style="display: none;">
                        <label>Current Image Src</label>
                        <input type="text" id="imageSrc" name="ImageSrc" value="@Content.Get("Balanceability:Sections:0:ImageContent:0:Src")" readonly />
                    </div>

                    <div class="form-group">
                        <label>Current Image Preview</label>
                        <img id="imagePreview" src="@Content.Get("Balanceability:Sections:0:ImageContent:0:Src")"
                             alt="@Content.Get("Balanceability:Sections:0:ImageContent:0:Alt")" style="max-width:200px;" />
                    </div>


                    <div class="form-group">
                        <label>Upload New Image</label>
                        <input type="file" id="imageFile" name="ImageFile" accept="image/*" />
                    </div>

                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>

            </form>

            <div id="successMessage" style="display:none;color:green;margin-top:10px;"></div>
        </div>

        <!-- Admin-only Bikeability Editor -->
        <div class="staff-section admin-section">
            <h2>Edit Bikeability Content</h2>

            <form id="bikeabilityForm">
                <div class="admin-editor">
                    <div class="form-group">
                        <label>Heading</label>
                        <input type="text" name="Heading" value="@Content.Get("Bikeability:Sections:0:TextContent:0:Heading")" />
                    </div>

                    <div class="form-group">
                        <label>Paragraph 1</label>
                        <textarea name="Paragraph1">@Content.Get("Bikeability:Sections:0:TextContent:1:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 2</label>
                        <textarea name="Paragraph2">@Content.Get("Bikeability:Sections:0:TextContent:2:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 3</label>
                        <textarea name="Paragraph3">@Content.Get("Bikeability:Sections:0:TextContent:3:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>List Item 1</label>
                        <textarea name="ListItem1">@Content.Get("Bikeability:Sections:0:TextContent:4:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>List Item 2</label>
                        <textarea name="ListItem2">@Content.Get("Bikeability:Sections:0:TextContent:5:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>List Item 3</label>
                        <textarea name="ListItem3">@Content.Get("Bikeability:Sections:0:TextContent:6:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 4</label>
                        <textarea name="Paragraph4">@Content.Get("Bikeability:Sections:0:TextContent:7:Paragraph")</textarea>
                    </div>

                    <div class="form-group" style="display: none;">
                        <label>Current Image Src</label>
                        <input type="text" id="imageSrcBike" name="ImageSrc" value="@Content.Get("Bikeability:Sections:0:ImageContent:0:Src")" readonly />
                    </div>

                    <div class="form-group">
                        <label>Current Image Preview</label>
                        <img id="imagePreviewBike" src="@Content.Get("Bikeability:Sections:0:ImageContent:0:Src")"
                             alt="@Content.Get("Bikeability:Sections:0:ImageContent:0:Alt")" style="max-width:200px;" />
                    </div>

                    <div class="form-group">
                        <label>Upload New Image</label>
                        <input type="file" id="imageFileBike" name="ImageFile" accept="image/*" />
                    </div>

                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>

            <div id="successMessageBike" style="display:none;color:green;margin-top:10px;"></div>
        </div>

        <!-- Admin-only Contact Us Editor -->
        <div class="staff-section admin-section">
            <h2>Edit Contact Us Content</h2>

            <form id="contactUsForm">
                <div class="admin-editor">
                    <div class="form-group">
                        <label>Heading</label>
                        <input type="text" name="Heading" value="@Content.Get("ContactUs:Sections:0:TextContent:0:Heading")" />
                    </div>

                    <div class="form-group">
                        <label>Paragraph 1</label>
                        <textarea name="Paragraph1">@Content.Get("ContactUs:Sections:0:TextContent:1:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 2</label>
                        <textarea name="Paragraph2">@Content.Get("ContactUs:Sections:0:TextContent:2:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 3</label>
                        <textarea name="Paragraph3">@Content.Get("ContactUs:Sections:0:TextContent:3:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 4</label>
                        <textarea name="Paragraph4">@Content.Get("ContactUs:Sections:0:TextContent:4:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 5</label>
                        <textarea name="Paragraph4">@Content.Get("ContactUs:Sections:0:TextContent:5:Paragraph")</textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>

            <div id="successMessageContactUs" style="display:none;color:green;margin-top:10px;"></div>
        </div>

        <!-- Admin-only Privacy Policy Editor -->
        <div class="staff-section admin-section">
            <h2>Edit Privacy Policy Content</h2>

            <form id="privacyPolicyForm">
                <div class="admin-editor">
                    <div class="form-group">
                        <label>Heading</label>
                        <input type="text" name="Heading" value="@Content.Get("PrivacyPolicy:Sections:0:TextContent:0:Heading")" />
                    </div>

                    <div class="form-group">
                        <label>Paragraph 1</label>
                        <textarea name="Paragraph1">@Content.Get("PrivacyPolicy:Sections:0:TextContent:1:Paragraph")</textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>

            <div id="successMessagePrivacyPolicy" style="display:none;color:green;margin-top:10px;"></div>
        </div>

        <!-- Admin-only Training Editor -->
        <div class="staff-section admin-section">
            <h2>Edit Training Content</h2>

            <form id="trainingForm">
                <div class="admin-editor">
                    <div class="form-group">
                        <label>Heading</label>
                        <input type="text" name="Heading" value="@Content.Get("Training:Sections:0:TextContent:0:Heading")" />
                    </div>

                    <div class="form-group">
                        <label>Paragraph 1</label>
                        <textarea name="Paragraph1">@Content.Get("Training:Sections:0:TextContent:1:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 2</label>
                        <textarea name="Paragraph2">@Content.Get("Training:Sections:0:TextContent:2:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 3</label>
                        <textarea name="Paragraph3">@Content.Get("Training:Sections:0:TextContent:3:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Paragraph 4</label>
                        <textarea name="Paragraph4">@Content.Get("Training:Sections:0:TextContent:4:Paragraph")</textarea>
                    </div>

                    <div class="form-group" style="display: none;">
                        <label>Current Image Src 1</label>
                        <input type="text" id="imageSrcTraining1" name="ImageSrc" value="@Content.Get("Training:Sections:0:ImageContent:0:Src")" readonly />
                    </div>

                    <div class="form-group">
                        <label>Current Image Preview</label>
                        <img id="imagePreviewTraining1" src="@Content.Get("Training:Sections:0:ImageContent:0:Src")"
                             alt="@Content.Get("Training:Sections:0:ImageContent:0:Alt")" style="max-width:200px;" />
                    </div>

                    <div class="form-group">
                        <label>Upload New Image</label>
                        <input type="file" id="imageFileTraining1" name="ImageFile" accept="image/*" />
                    </div>

                    <div class="form-group" style="display: none;">
                        <label>Current Image Src 2</label>
                        <input type="text" id="imageSrcTraining2" name="ImageSrc" value="@Content.Get("Training:Sections:0:ImageContent:1:Src")" readonly />
                    </div>

                    <div class="form-group">
                        <label>Current Image Preview</label>
                        <img id="imagePreviewTraining2" src="@Content.Get("Training:Sections:0:ImageContent:1:Src")"
                             alt="@Content.Get("Training:Sections:0:ImageContent:1:Alt")" style="max-width:200px;" />
                    </div>

                    <div class="form-group">
                        <label>Upload New Image</label>
                        <input type="file" id="imageFileTraining2" name="ImageFile" accept="image/*" />
                    </div>

                    <div class="form-group" style="display: none;">
                        <label>Current Document Src</label>
                        <input type="text" id="documentSrcTraining" name="ImageSrc" value="@Content.Get("Training:Sections:0:DownloadableContent:0:Src")" readonly />
                    </div>

                    <div class="form-group">
                        <label>Current Document:</label>
                            <p id="documentPreviewTraining">@Content.Get("Training:Sections:0:DownloadableContent:0:Src")</p>
                    </div>

                    <div class="form-group">
                        <label>Upload New Document</label>
                        <input type="file" id="documentFileTraining" name="ImageFile" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt" />
                    </div>

                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>

            <div id="successMessageTraining" style="display:none;color:green;margin-top:10px;"></div>
        </div>

        //The Team:

        <!-- Admin-only TheTeam Editor -->
        <div class="staff-section admin-section">
            <h2>Edit Team Members</h2>

            <form id="teamForm">
                <div id="teamMembersContainer" class="admin-editor">
                    @{
                        int i = 1; // start after the intro
                        while (true)
                        {
                            var heading = Content.Get($"TheTeam:Sections:0:TextContent:{i}:Heading");
                            var paragraph = Content.Get($"TheTeam:Sections:0:TextContent:{i}:Paragraph");

                            if (string.IsNullOrWhiteSpace(paragraph))
                            {
                                break; // stop if no more members
                            }

                            <text>
                                <div class="form-group team-member-group">
                                    <label>Team Member Name</label>
                                    <input type="text" name="Members[@i].Heading" value="@heading" />

                                    <label>Job Title & Description</label>
                                    <textarea name="Members[@i].Paragraph">@paragraph</textarea>

                                    <button type="button" class="btn btn-danger remove-member">Remove</button>
                                </div>
                            </text>

                            i++;
                        }
                    }
                </div>

                <button type="button" id="addTeamMember" class="btn btn-secondary" style="margin-top:10px;">Add Team Member</button>
                <button type="submit" class="btn btn-primary" style="margin-top:10px;">Save Changes</button>
            </form>

            <div id="successMessageTeam" style="display:none;color:green;margin-top:10px;"></div>
        </div>

        //Memberships:

        <!-- Admin-only Memberships Editor -->
        <div class="staff-section admin-section">
            <h2>Edit Memberships Content</h2>

            <form id="membershipsForm">
                <div class="admin-editor">

                    <!-- Intro -->
                    <div class="form-group">
                        <label>Heading</label>
                        <input type="text" name="Heading" value="@Content.Get("Memberships:Sections:0:TextContent:0:Heading")" />
                    </div>
                    <div class="form-group">
                        <label>Paragraph 1</label>
                        <textarea name="Paragraph1">@Content.Get("Memberships:Sections:0:TextContent:1:Paragraph")</textarea>
                    </div>
                    <div class="form-group">
                        <label>Paragraph 2</label>
                        <textarea name="Paragraph2">@Content.Get("Memberships:Sections:0:TextContent:2:Paragraph")</textarea>
                    </div>
                    <div class="form-group">
                        <label>Paragraph 3</label>
                        <textarea name="Paragraph3">@Content.Get("Memberships:Sections:0:TextContent:3:Paragraph")</textarea>
                    </div>
                    <div class="form-group">
                        <label>Paragraph 4</label>
                        <textarea name="Paragraph4">@Content.Get("Memberships:Sections:0:TextContent:4:Paragraph")</textarea>
                    </div>
                    <div class="form-group">
                        <label>Paragraph 5</label>
                        <textarea name="Paragraph5">@Content.Get("Memberships:Sections:0:TextContent:5:Paragraph")</textarea>
                    </div>
                    <div class="form-group">
                        <label>Paragraph 6</label>
                        <textarea name="Paragraph6">@Content.Get("Memberships:Sections:0:TextContent:6:Paragraph")</textarea>
                    </div>

                    <!-- Packages -->
                    <div class="form-group">
                        <label>Bronze Heading</label>
                        <input type="text" name="BronzeHeading" value="@Content.Get("Memberships:Sections:0:TextContent:6:Heading")" />
                    </div>
                    <div class="form-group">
                        <label>Bronze Paragraph</label>
                        <textarea name="BronzeParagraph">@Content.Get("Memberships:Sections:0:TextContent:6:Paragraph")</textarea>
                    </div>
                    <div class="form-group">
                        <label>Silver Heading</label>
                        <input type="text" name="SilverHeading" value="@Content.Get("Memberships:Sections:0:TextContent:7:Heading")" />
                    </div>
                    <div class="form-group">
                        <label>Silver Paragraph</label>
                        <textarea name="SilverParagraph">@Content.Get("Memberships:Sections:0:TextContent:7:Paragraph")</textarea>
                    </div>
                    <div class="form-group">
                        <label>Gold Heading</label>
                        <input type="text" name="GoldHeading" value="@Content.Get("Memberships:Sections:0:TextContent:8:Heading")" />
                    </div>
                    <div class="form-group">
                        <label>Gold Paragraph</label>
                        <textarea name="GoldParagraph">@Content.Get("Memberships:Sections:0:TextContent:8:Paragraph")</textarea>
                    </div>

                    <!-- CPD / Competitions / Contact -->
                    <div class="form-group">
                        <label>CPD Heading</label>
                        <input type="text" name="CPDHeading" value="@Content.Get("Memberships:Sections:0:TextContent:9:Heading")" />
                    </div>
                    <div class="form-group">
                        <label>CPD Paragraph</label>
                        <textarea name="CPDParagraph">@Content.Get("Memberships:Sections:0:TextContent:9:Paragraph")</textarea>
                    </div>
                    <div class="form-group">
                        <label>Competitions Heading</label>
                        <input type="text" name="CompetitionsHeading" value="@Content.Get("Memberships:Sections:0:TextContent:10:Heading")" />
                    </div>
                    <div class="form-group">
                        <label>Competitions Paragraph</label>
                        <textarea name="CompetitionsParagraph">@Content.Get("Memberships:Sections:0:TextContent:10:Paragraph")</textarea>
                    </div>
                    <div class="form-group">
                        <label>Get in Touch Heading</label>
                        <input type="text" name="GetInTouchHeading" value="@Content.Get("Memberships:Sections:0:TextContent:11:Heading")" />
                    </div>
                    <div class="form-group">
                        <label>Get in Touch Paragraph</label>
                        <textarea name="GetInTouchParagraph">@Content.Get("Memberships:Sections:0:TextContent:11:Paragraph")</textarea>
                    </div>

                    <!-- Images -->
                    @for (int b = 0; b < 5; b++)
                    {
                        <div class="form-group" style="display:none;">
                            <label>Current Image @(b + 1) Src</label>
                            <input type="text" id="imageSrcMembership@(b + 1)" name="ImageSrc@(b + 1)" value="@Content.Get($"Memberships:Sections:0:ImageContent:{b}:Src")" readonly />
                        </div>

                        <div class="form-group">
                            <label>Current Image @(b + 1) Preview</label>
                            <img id="imagePreviewMembership@(b + 1)" src="@Content.Get($"Memberships:Sections:0:ImageContent:{b}:Src")"
                                 alt="@Content.Get($"Memberships:Sections:0:ImageContent:{b}:Alt")" style="max-width:200px;" />
                        </div>

                        <div class="form-group">
                            <label>Upload New Image @(b + 1)</label>
                            <input type="file" id="imageFileMembership@(b + 1)" accept="image/*" />
                        </div>
                    }



                    <!-- Document -->
                    <div class="form-group" style="display: none;">
                        <label>Current Packages Document Src</label>
                        <input type="text" id="documentSrcMemberships" name="PackagesDocumentSrc" value="@Content.Get("Memberships:Sections:0:DownloadableContent:0:Src")" readonly />
                    </div>

                    <div class="form-group">
                        <label>Current Packages Document:</label>
                        <p id="documentPreviewMemberships">@Content.Get("Memberships:Sections:0:DownloadableContent:0:Src")</p>
                    </div>

                    <div class="form-group">
                        <label>Upload New Packages Document</label>
                        <input type="file" id="documentFileMemberships" name="PackagesDocumentFile" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt" />
                    </div>

                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>

            <div id="successMessageMemberships" style="display:none;color:green;margin-top:10px;"></div>
        </div>

        // Events:

        <!-- Admin-only Events Editor -->
        <div class="staff-section admin-section">
            <h2>Edit Events</h2>

            <form id="eventsForm">
                <div class="admin-editor">
                    <!-- Intro Section -->
                    <div class="form-group">
                        <label>Intro Heading</label>
                        <input type="text" name="IntroHeading" value="@Content.Get("Events:Sections:0:TextContent:0:Heading")" />
                    </div>

                    <div class="form-group">
                        <label>Intro Paragraph 1</label>
                        <textarea name="IntroParagraph1">@Content.Get("Events:Sections:0:TextContent:1:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Intro Paragraph 2</label>
                        <textarea name="IntroParagraph2">@Content.Get("Events:Sections:0:TextContent:2:Paragraph")</textarea>
                    </div>

                    <div class="form-group">
                        <label>Intro Paragraph 3</label>
                        <textarea name="IntroParagraph3">@Content.Get("Events:Sections:0:TextContent:3:Paragraph")</textarea>
                    </div>

                    <!-- Dynamic Events -->
                    <div id="eventsContainer">
                        @{
                            int c = 4; // events start at index 4
                            while (true)
                            {
                                var heading = Content.Get($"Events:Sections:0:TextContent:{c}:Heading");
                                var paragraph = Content.Get($"Events:Sections:0:TextContent:{c}:Paragraph");
                                var status = Content.Get($"Events:Sections:0:TextContent:{c}:Status");
                                var bookingUrl = Content.Get($"Events:Sections:0:TextContent:{c}:BookingUrl");
                                var startDate = Content.Get($"Events:Sections:0:TextContent:{c}:StartDate");
                                var endDate = Content.Get($"Events:Sections:0:TextContent:{c}:EndDate");

                                if (string.IsNullOrWhiteSpace(heading) && string.IsNullOrWhiteSpace(paragraph))
                                {
                                    break; // stop if there are no more events
                                }
                                <text>
                                    <div class="form-group event-group">
                                        <label>Event Heading</label>
                                        <input type="text" name="Events[@c].Heading" value="@heading" />

                                        <label>Event Description</label>
                                        <textarea name="Events[@c].Paragraph">@paragraph</textarea>

                                        <label>Status</label>
                                        <select name="Events[@c].Status">
                                            <option value="Coming Soon" selected="@(status == "Coming Soon")">Coming Soon</option>
                                            <option value="Open" selected="@(status == "Open")">Open</option>
                                            <option value="Closed" selected="@(status == "Closed")">Closed</option>
                                        </select>

                                        <label>Booking URL</label>
                                        <input type="text" name="Events[@c].BookingUrl" value="@bookingUrl" />

                                        <div class="date-fields">
                                            <div>
                                                <label>Start Date</label>
                                                <input type="date" name="Events[@c].StartDate" value="@startDate" />
                                            </div>
                                            <div>
                                                <label>End Date</label>
                                                <input type="date" name="Events[@c].EndDate" value="@endDate" />
                                            </div>
                                        </div>

                                        <button type="button" class="btn btn-danger remove-event" style="margin-top:5px;">Remove Event</button>
                                    </div>
                                </text>
                                c++;
                            }
                        }
                    </div>

                    <button type="button" id="addEvent" class="btn btn-secondary" style="margin-top:10px;">Add Event</button>
                    <button type="submit" class="btn btn-primary" style="margin-top:10px;">Save Changes</button>
                </div>
            </form>

            <div id="successMessageEvents" style="display:none;color:green;margin-top:10px;"></div>
        </div>


        // MEmbers Area:
