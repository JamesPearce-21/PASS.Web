@{
    ViewData["Title"] = "Staff Login";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Members.css" asp-append-version="true" />
}

<section class="members-section">
    <div class="login-contact-wrapper" style="justify-content:center;">
        <div class="login-box">
            <h2>Staff Login</h2>
            <p>Enter your admin credentials to access the staff CMS.</p>
            <form method="post" action="/StaffArea/Login" class="login-form">
                <input type="text" name="username" placeholder="Username" required />
                <input type="password" name="password" placeholder="Password" required />
                <button type="submit" class="login-btn">Login</button>

                @if (TempData["LoginError"] != null)
                {
                    <div class="login-error" style="display:block;">@TempData["LoginError"]</div>
                }
            </form>
        </div>
    </div>
</section>
