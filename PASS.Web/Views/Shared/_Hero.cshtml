@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Hero.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/hero.js" asp-append-version="true"></script>
}

@inject PASS.Web.Services.ContentService Content

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-content">
        <div class="form-container">
            <h1>@Content.Get("Hero:Sections:0:TextContent:0:Heading")</h1>
            <p>@Content.Get("Hero:Sections:0:TextContent:0:Paragraph")</p>
        </div>
    </div>
    <div class="hero-image">
        <img src="@Content.Get("Hero:Sections:0:ImageContent:0:Src")"
             alt="@Content.Get("Hero:Sections:0:ImageContent:0:Alt")" />
    </div>
</section>

<!-- Course Grid -->
<section class="course-grid">
    @{
        int i = 0;
        while(true)
        {
            var icon = Content.Get($"Hero:Sections:1:CourseGrid:{i}:Icon");
            var heading = Content.Get($"Hero:Sections:1:CourseGrid:{i}:Heading");
            if(string.IsNullOrWhiteSpace(heading)) break; // stop if no more courses
            var paragraph = Content.Get($"Hero:Sections:1:CourseGrid:{i}:Paragraph");
            var linkUrl = Content.Get($"Hero:Sections:1:CourseGrid:{i}:LinkUrl");
            var linkText = Content.Get($"Hero:Sections:1:CourseGrid:{i}:LinkText");

        <div class="course-box">
            <div class="course-icon">@icon</div>
            <h3>@heading</h3>
            <p>@paragraph</p>
            <a href="@linkUrl" class="course-btn">@linkText</a>
        </div>
            i++;
        }
    }
</section>

<!-- Mission Section -->
<section class="mission-section">
    <div class="mission-container">
        <h2>@Content.Get("Hero:Sections:2:Mission:Heading")</h2>
        <h3 class="intent-label">@Content.Get("Hero:Sections:2:Mission:SubHeading")</h3>
        <p>@Content.Get("Hero:Sections:2:Mission:Paragraph")</p>
    </div>
</section>

<!-- Impact Stats Section -->
<section class="logos impact-carousel">
    <div class="logos-slide">
        @{
            int b = 0;
            while(true)
            {
                var value = Content.Get($"Hero:Sections:3:ImpactStats:{b}:Value");
                var label = Content.Get($"Hero:Sections:3:ImpactStats:{b}:Label");
                if(string.IsNullOrWhiteSpace(value) && string.IsNullOrWhiteSpace(label)) break;

        <div class="impact-stat">
            <span>@value</span>
            <p>@label</p>
        </div>

                b++;
            }
        }
        <!-- Clone for seamless looping -->
        @{
           b = 0;
            while(true)
            {
                var value = Content.Get($"Hero:Sections:3:ImpactStats:{b}:Value");
                var label = Content.Get($"Hero:Sections:3:ImpactStats:{b}:Label");
                if(string.IsNullOrWhiteSpace(value) && string.IsNullOrWhiteSpace(label)) break;

        <div class="impact-stat">
            <span>@value</span>
            <p>@label</p>
        </div>

                b++;
            }
        }
    </div>
</section>

<!-- Testimonials Section -->
<section class="testimonial-slider">
    <h2>Here’s what our schools have to say…</h2>
    <div class="testimonial-display">
        @{
            var firstQuote = Content.Get("Hero:Sections:4:Testimonials:0:Quote");
            var firstAuthor = Content.Get("Hero:Sections:4:Testimonials:0:Author");
        }
        <p id="quote-text">@firstQuote</p>
        <span id="quote-author">@firstAuthor</span>
    </div>
    <div class="testimonial-nav">
        @{
            int c = 0;
            while(true)
            {
                var quote = Content.Get($"Hero:Sections:4:Testimonials:{c}:Quote");
                var author = Content.Get($"Hero:Sections:4:Testimonials:{c}:Author");
                if(string.IsNullOrWhiteSpace(quote) && string.IsNullOrWhiteSpace(author)) break;

            <button class="quote-btn @(c == 0 ? "active" : "")" data-index="@c"></button>

                c++;
            }
        }
    </div>
</section>

<!-- Membership Accordion Section -->
<section class="membership-accordion-section">
    <h2>@Content.Get("Hero:Sections:5:MembershipAccordion:Heading")</h2>
    <div class="accordion">
        <button class="accordion-toggle" aria-expanded="false" aria-controls="schoolsPanel" id="schoolsToggle">
            <span>PASS Membership Schools</span>
            <span class="accordion-icon">+</span>
        </button>
        <div class="accordion-panel" id="schoolsPanel" role="region" aria-labelledby="schoolsToggle" hidden>
            <ul class="schools-list">
                @{
                    int d = 0;
                    while(true)
                    {
                        var school = Content.Get($"Hero:Sections:5:MembershipAccordion:Schools:{d}");
                        if(string.IsNullOrWhiteSpace(school)) break;

                <li>@school</li>

                        d++;
                    }
                }
            </ul>
        </div>

        <button class="accordion-toggle" aria-expanded="false" aria-controls="credentialsPanel" id="credentialsToggle">
            <span>Our Credentials & Delivery</span>
            <span class="accordion-icon">+</span>
        </button>
        <div class="accordion-panel" id="credentialsPanel" role="region" aria-labelledby="credentialsToggle" hidden>
            <ul class="credentials-list">
                @{
                    int e = 0;
                    while(true)
                    {
                        var cred = Content.Get($"Hero:Sections:5:MembershipAccordion:Credentials:{e}");
                        if(string.IsNullOrWhiteSpace(cred)) break;

                <li>@cred</li>

                        e++;
                    }
                }
            </ul>
        </div>
    </div>
</section>

<script>
    // Accordion toggle script (vanilla JS)
    document.querySelectorAll('.accordion-toggle').forEach(button => {
        button.addEventListener('click', () => {
            const expanded = button.getAttribute('aria-expanded') === 'true';
            button.setAttribute('aria-expanded', !expanded);
            const panel = document.getElementById(button.getAttribute('aria-controls'));
            if (!expanded) panel.removeAttribute('hidden');
            else panel.setAttribute('hidden', '');
        });
    });
</script>
