@{
    ViewData["Title"] = "Members Area";
    bool isLoggedIn = ViewBag.IsLoggedIn ?? false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Members.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/members.js" asp-append-version="true"></script>
}

@inject PASS.Web.Services.ContentService Content

<section class="members-section">

    <!-- Login + Contact Form Section -->
    <div class="login-contact-wrapper" style="@(isLoggedIn ? "display:none;" : "display:flex;")">
        <div class="login-box">
            <h2>@Content.Get("MembersArea:Sections:0:TextContent:0:Heading")</h2>
            <p>@Content.Get("MembersArea:Sections:0:TextContent:0:Paragraph")</p>
            <form method="post" action="/Account/Login" class="login-form-styling">
                <input type="text" name="username" placeholder="Username" required />
                <input type="password" name="password" placeholder="Password" required />
                <button type="submit" class="login-btn">Login</button>

                @if (TempData["LoginError"] != null)
                {
                    <div class="login-error" style="display:block;">@TempData["LoginError"]</div>
                }
            </form>
        </div>

        <div class="contact-box">
            <h2>@Content.Get("MembersArea:Sections:0:TextContent:1:Heading")</h2>
            <p>@Content.Get("MembersArea:Sections:0:TextContent:1:Paragraph")</p>
            <a href="@Content.Get("MembersArea:Sections:0:TextContent:1:LinkUrl")" class="contact-btn">
                @Content.Get("MembersArea:Sections:0:TextContent:1:LinkText")
            </a>
        </div>
    </div>

    <!-- Public Sample Lesson Plans -->
    <div class="example-section public-samples">
        <h2>@Content.Get("MembersArea:Sections:1:TextContent:0:Heading")</h2>
        <p>@Content.Get("MembersArea:Sections:1:TextContent:0:Paragraph")</p>
        <div class="sample-list">
            @{
                var sampleIndex = 0;
                while (!string.IsNullOrEmpty(Content.Get($"MembersArea:Sections:1:TextContent:0:Documents:{sampleIndex}:Title")))
                {
                    <a href="@Content.Get($"MembersArea:Sections:1:TextContent:0:Documents:{sampleIndex}:Url")" class="sample-link">
                        @Content.Get($"MembersArea:Sections:1:TextContent:0:Documents:{sampleIndex}:Title")
                    </a>
                    ;
                    sampleIndex++;
                }
            }
        </div>
    </div>

    <!-- Members Content -->
    <div class="members-content" style="@(isLoggedIn ? "display:block;" : "display:none;")">
        <div class="members-intro">
            <h1>@Content.Get("MembersArea:Sections:2:TextContent:0:Heading")</h1>
            <p>@Content.Get("MembersArea:Sections:2:TextContent:0:Paragraph")</p>
        </div>

        <div class="schemes-section">
            <h2>@Content.Get("MembersArea:Sections:2:Heading")</h2>
            <div class="year-group-list">

                @{
                    // Loop through all year groups
                    var schemeIndex = 0;
                    while (!string.IsNullOrEmpty(Content.Get($"MembersArea:Sections:2:Schemes:{schemeIndex}:YearGroup")))
                    {
                        <div class="year-group-card">
                            <h3>@Content.Get($"MembersArea:Sections:2:Schemes:{schemeIndex}:YearGroup")</h3>
                            <ul class="scheme-links">
                                @{
                                    var docIndex = 0;
                                    while (!string.IsNullOrEmpty(Content.Get($"MembersArea:Sections:2:Schemes:{schemeIndex}:Documents:{docIndex}:Title")))
                                    {
                                        <li>
                                            <a href="@Content.Get($"MembersArea:Sections:2:Schemes:{schemeIndex}:Documents:{docIndex}:Url")">
                                                @Content.Get($"MembersArea:Sections:2:Schemes:{schemeIndex}:Documents:{docIndex}:Title")
                                            </a>
                                        </li>
                                        ;
                                        docIndex++;
                                    }
                            }
                        </ul>
                    </div>
;
                        schemeIndex++;
                    }
                }

            </div>
        </div>
    </div>
</section>
