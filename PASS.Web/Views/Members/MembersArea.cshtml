@{
    ViewData["Title"] = "Members Area";
    bool isLoggedIn = ViewBag.IsLoggedIn ?? false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Members.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/members.js" asp-append-version="true"></script>
}

<section class="members-section">

    <!-- Login + Contact Form Section -->
    <div class="login-contact-wrapper" style="@(isLoggedIn ? "display:none;" : "display:flex;")">
        <div class="login-box">
            <h2>Member Login</h2>
            <p>Enter your login credentials to access PASS member resources.</p>
            <form method="post" action="/Account/Login" class="login-form-styling">
                <input type="text" name="username" placeholder="Username" required />
                <input type="password" name="password" placeholder="Password" required />
                <button type="submit" class="login-btn">Login</button>

                @if (TempData["LoginError"] != null)
                {
                    <div class="login-error" style="display:block;">@TempData["LoginError"]</div>
                }
            </form>
        </div>

        <div class="contact-box">
            <h2>Not a Member?</h2>
            <p>If you're interested in accessing our high-quality PE resources, please get in touch with us.</p>
            <a href="/contact" class="contact-btn">Contact Us</a>
        </div>
    </div>

    <!-- Public Sample Lesson Plans (always visible) -->
    <div class="example-section public-samples">
        <h2>Free Sample Lesson Plans</h2>
        <p>Try a couple of example lessons—no login required.</p>
        <div class="sample-list">
            <a href="/downloads/sample-lesson-ks1.pdf" target="_blank" class="sample-link">KS1 Sample Lesson</a>
            <a href="/downloads/sample-lesson-ks2.pdf" target="_blank" class="sample-link">KS2 Sample Lesson</a>
        </div>
    </div>

    <!-- Members Content (visible only when logged in) -->
    <div class="members-content" style="@(isLoggedIn ? "display:block;" : "display:none;")">
        <div class="members-intro">
            <h1>Members Area</h1>
            <p>As a PASS member school, you gain access to high-quality PE schemes of work from EYFS to Year 6. These comprehensive resources are built to support inclusive, progressive, and exciting PE delivery.</p>
        </div>

        <div class="schemes-section">
            <h2>Download Schemes of Work</h2>
            <div class="year-group-list">
                <!-- EYFS -->
                <div class="year-group-card">
                    <h3>Reception / EYFS</h3>
                    <ul class="scheme-links">
                        <li><a href="/Assets/Documents/PASS Year R - Tennis.pdf">PASS Year R - Tennis</a></li>
                        <li><a href="/Assets/Documents/PASS Year R - Manipulative Skills.pdf">PASS Year R - Manipulative Skills</a></li>
                        <li><a href="/Assets/Documents/PASS Year R - Gymnastics.pdf">PASS Year R - Gymnastics</a></li>
                        <li><a href="/Assets/Documents/PASS Year R - Athletics.pdf">PASS Year R - Athletics</a></li>
                    </ul>
                </div>

                <!-- Year 1 -->
                <div class="year-group-card">
                    <h3>Year 1</h3>
                    <ul class="scheme-links">
                        <li><a href="/Assets/Documents/PASS Year 1 Dance - Toys.pdf">PASS Year 1 Dance - Toys</a></li>
                        <li><a href="/Assets/Documents/PASS Year 1 Dance - Superworm.pdf">PASS Year 1 Dance - Superworm</a></li>
                        <li><a href="/Assets/Documents/PASS Year 1 - Fitness.pdf">PASS Year 1 - Fitness</a></li>
                    </ul>
                </div>

                <!-- Year 2 -->
                <div class="year-group-card">
                    <h3>Year 2</h3>
                    <ul class="scheme-links">
                        <li><a href="/Assets/Documents/PASS Year 2 Gymnastics - Unit 2.pdf">PASS Year 2 Gymnastics - Unit 2</a></li>
                        <li><a href="/Assets/Documents/PASS Year 2 Gymnastics - Unit 1.pdf">PASS Year 2 Gymnastics - Unit 1</a></li>
                        <li><a href="/Assets/Documents/PASS - Year 2 Dance Frozen.pdf">PASS - Year 2 Dance Frozen</a></li>
                        <li><a href="/Assets/Documents/PASS - Year 2 Dance - Superheroes.pdf">PASS - Year 2 Dance - Superheroes</a></li>
                    </ul>
                </div>

                <!-- Year 3 -->
                <div class="year-group-card">
                    <h3>Year 3</h3>
                    <ul class="scheme-links">
                        <li><a href="/Assets/Documents/PASS Year 3 Unit 2 - Gymnastics Resources.pdf">PASS Year 3 Unit 2 - Gymnastics Resources</a></li>
                        <li><a href="/Assets/Documents/PASS Year 3 Gymnastics - Unit 2.pdf">PASS Year 3 Gymnastics - Unit 2</a></li>
                        <li><a href="/Assets/Documents/PASS Year 3 Gymnastics - Unit 1.pdf">PASS Year 3 Gymnastics - Unit 1</a></li>
                        <li><a href="/Assets/Documents/PASS Year 3 - Fitness.pdf">PASS Year 3 - Fitness</a></li>
                        <li><a href="/Assets/Documents/PASS Year 3 - Basketball.pdf">PASS Year 3 - Basketball</a></li>
                    </ul>
                </div>

                <!-- Year 4 -->
                <div class="year-group-card">
                    <h3>Year 4</h3>
                    <ul class="scheme-links">
                        <li><a href="/Assets/Documents/PASS Year 4 - Netball.pdf">PASS Year 4 - Netball</a></li>
                        <li><a href="/Assets/Documents/PASS Y4 Dance - Electricity.pdf">PASS Y4 Dance - Electricity</a></li>
                    </ul>
                </div>

                <!-- Year 5 -->
                <div class="year-group-card">
                    <h3>Year 5</h3>
                    <ul class="scheme-links">
                        <li><a href="/Assets/Documents/PASS Year 5 Gymnastics - Unit 2.pdf">PASS Year 5 Gymnastics - Unit 2</a></li>
                        <li><a href="/Assets/Documents/PASS Year 5 - Netball.pdf">PASS Year 5 - Netball</a></li>
                        <li><a href="/Assets/Documents/PASS Year 5 - Hockey.pdf">PASS Year 5 - Hockey</a></li>
                        <li><a href="/Assets/Documents/PASS Year 5 - Dance Natural Disasters.pdf">PASS Year 5 - Dance Natural Disasters</a></li>
                        <li><a href="/Assets/Documents/PASS Year 5 - Dance - Mad Hatters Tea Party.pdf">PASS Year 5 - Dance - Mad Hatters Tea Party</a></li>
                        <li><a href="/Assets/Documents/PASS Year 5 - Basketball.pdf">PASS Year 5 - Basketball</a></li>
                        <li><a href="/Assets/Documents/PASS Y5 Dance - Street Dance.pdf">PASS Y5 Dance - Street Dance</a></li>
                    </ul>
                </div>

                <!-- Year 6 -->
                <div class="year-group-card">
                    <h3>Year 6</h3>
                    <ul class="scheme-links">
                        <li><a href="/Assets/Documents/PASS Year 6 - Athletics.pdf">PASS Year 6 - Athletics</a></li>
                    </ul>
                </div>

                <!-- UKS2 / LKS2 -->
                <div class="year-group-card">
                    <h3>UKS2 / LKS2</h3>
                    <ul class="scheme-links">
                        <li><a href="/Assets/Documents/PASS LKS2 - Tri Golf.pdf">PASS LKS2 - Tri Golf</a></li>
                        <li><a href="/Assets/Documents/PASS UKS2 - Handball.pdf">PASS UKS2 - Handball</a></li>
                        <li><a href="/Assets/Documents/PASS LKS2 - Badminton.pdf">PASS LKS2 - Badminton</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
