@{
    ViewData["Title"] = "Members Area";
    bool isLoggedIn = ViewBag.IsLoggedIn ?? false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Members.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/members.js" asp-append-version="true"></script>
}

<section class="members-section">

    <!-- Login + Contact Form Section -->
    <div class="login-contact-wrapper" style="@(isLoggedIn ? "display:none;" : "display:flex;")">
        <div class="login-box">
            <h2>Member Login</h2>
            <p>Enter your login credentials to access PASS member resources.</p>
            <form method="post" action="/Account/Login" class="login-form-styling">
                <input type="text" name="username" placeholder="Username" required />
                <input type="password" name="password" placeholder="Password" required />
                <button type="submit" class="login-btn">Login</button>

                @if (TempData["LoginError"] != null)
                {
                    <div class="login-error" style="display:block;">@TempData["LoginError"]</div>
                }
            </form>
        </div>

        <div class="contact-box">
            <h2>Not a Member?</h2>
            <p>If you're interested in accessing our high-quality PE resources, please get in touch with us.</p>
            <a href="/contact" class="contact-btn">Contact Us</a>
        </div>
    </div>

    <!-- Public Sample Lesson Plans (always visible) -->
    <div class="example-section public-samples">
        <h2>Free Sample Lesson Plans</h2>
        <p>Try a couple of example lessons—no login required.</p>
        <div class="sample-list">
            <a href="/Assets/Documents/PASS Year 2 - Athletics - SAMPLE" class="sample-link">PASS Year 2 Athletics</a>
            <a href="/Assets/Documents/PASS Year 5 - Basketball - SAMPLE.pdf" class="sample-link">PASS Year 5 - Basketball</a>
        </div>
    </div>

    <!-- Members Content (visible only when logged in) -->
