@{
    ViewData["Title"] = "Events";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Events.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/events.js" asp-append-version="true"></script>
}

<section class="events-section">
    <div class="events-intro">
        <h1>Our Events</h1>
        <p>At PASS, we are proud to deliver a diverse range of high-quality, inclusive festivals and competitions that cater to all ages and abilities.</p>
        <p>Our events are designed to inspire participation, celebrate achievement, and ensure every young person - regardless of skill level - has the opportunity to enjoy and succeed in physical activity.</p>
        <p>Below are some examples of our upcoming events:</p>
    </div>

    <div class="events-list">
        <!-- Event 1 -->
        <div class="event-item">
            <h3>Sports Crew Training - 01/01/2026</h3>
            <p>A training session for sports crew to develop their leadership and teamwork skills.</p>
            <a href="#" class="event-btn coming-soon">Coming Soon</a>
            <a href="#" class="event-btn booking-form">Booking Form</a>
        </div>

        <!-- Event 2 -->
        <div class="event-item">
            <h3>KS2 Hockey - 01/01/2026</h3>
            <p>A hockey competition for Key Stage 2 students focusing on teamwork and skill development.</p>
            <a href="#" class="event-btn open">Open</a>
            <a href="#" class="event-btn booking-form">Booking Form</a>
        </div>

        <!-- Event 3 -->
        <div class="event-item">
            <h3>KS1 Dance and Movement Festival - 01/01/2026</h3>
            <p>A fun and engaging festival for KS1 students to explore dance and movement.</p>
            <a href="#" class="event-btn closed">Closed</a>
            <a href="#" class="event-btn booking-form">Booking Form</a>
        </div>

        <!-- Event 4 -->
        <div class="event-item">
            <h3>This Girl Can Festival - 01/01/2026</h3>
            <p>A celebration of female participation in sports, designed to encourage girls of all ages to get active.</p>
            <a href="#" class="event-btn open">Open</a>
            <a href="#" class="event-btn booking-form">Booking Form</a>
        </div>

        <!-- Event 5 -->
        <div class="event-item">
            <h3>Cross Country - 01/01/2026</h3>
            <p>A cross-country race for all ages to challenge endurance and fitness levels.</p>
            <a href="#" class="event-btn coming-soon">Coming Soon</a>
            <a href="#" class="event-btn booking-form">Booking Form</a>
        </div>

        <!-- Event 6 -->
        <div class="event-item">
            <h3>Cross Country - 01/01/2026</h3>
            <p>A cross-country race for all ages to challenge endurance and fitness levels.</p>
            <a href="#" class="event-btn coming-soon">Coming Soon</a>
            <a href="#" class="event-btn booking-form">Booking Form</a>
        </div>
    </div>
</section>
