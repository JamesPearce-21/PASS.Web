@{
    ViewData["Title"] = "Events";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Events.css" asp-append-version="true" />
}

@inject PASS.Web.Services.ContentService Content

<section class="events-section">
    <div class="events-intro">
        <h1>@Content.Get("Events:Sections:0:TextContent:0:Heading")</h1>
        <p>@Content.Get("Events:Sections:0:TextContent:1:Paragraph")</p>
        <p>@Content.Get("Events:Sections:0:TextContent:2:Paragraph")</p>
        <p>@Content.Get("Events:Sections:0:TextContent:3:Paragraph")</p>
    </div>

    <div class="events-list">
        @{
            int i = 4; // Start after the intro paragraphs
            while (true)
            {
                var heading = Content.Get($"Events:Sections:0:TextContent:{i}:Heading");
                var paragraph = Content.Get($"Events:Sections:0:TextContent:{i}:Paragraph");
                var status = Content.Get($"Events:Sections:0:TextContent:{i}:Status");
                var bookingUrl = Content.Get($"Events:Sections:0:TextContent:{i}:BookingUrl");

                if (string.IsNullOrWhiteSpace(heading) && string.IsNullOrWhiteSpace(paragraph))
                {
                    break; // Stop if no more events
                }

                // Determine status class for styling
                var statusClass = status?.ToLower().Replace(" ", "-") ?? "open";

                <div class="event-item">
                    <h3>@heading</h3>
                    <p>@paragraph</p>
                    <a href="#" class="event-btn @statusClass">@status</a>
                    <a href="@bookingUrl" class="event-btn booking-form">Booking Form</a>
                </div>
                i++;
            }
        }
    </div>
</section>
