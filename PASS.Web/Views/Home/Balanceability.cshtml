@{
    ViewData["Title"] = "Balanceability";
}

@section Styles {
        <link rel="stylesheet" href="~/css/Balanceability.css" asp-append-version="true" />
}

@inject PASS.Web.Services.ContentService Content

<section class="balanceability-section">
    <div class="balanceability-grid">
        <div class="text-content">
            <h1 class="fade-in">@Content.Get("Balanceability:Sections:0:TextContent:0:Heading")</h1>
            <p class="lead fade-in delay-1">@Content.Get("Balanceability:Sections:0:TextContent:0:Paragraph")</p>
            <p class="fade-in delay-2">@Content.Get("Balanceability:Sections:0:TextContent:1:Paragraph")</p>
            <p class="fade-in delay-3">@Content.Get("Balanceability:Sections:0:TextContent:2:Paragraph")</p>
            <p class="fade-in delay-4">@Content.Get("Balanceability:Sections:0:TextContent:3:Paragraph")</p>
            <p class="fade-in delay-4">@Content.Get("Balanceability:Sections:0:TextContent:4:Paragraph")</p>
        </div>
        <div class="image-content fade-in delay-5">
            <div class="image-card">
                <img src="@Content.Get("Balanceability:Sections:0:ImageContent:0:Src")"
                     alt="@Content.Get("Balanceability:Sections:0:ImageContent:0:Alt")">
            </div>
        </div>
    </div>
</section>