@{
    ViewData["Title"] = "The Team";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Team.css" asp-append-version="true" />
}

@inject PASS.Web.Services.ContentService Content

@section Scripts {
    <script src="~/js/team.js" asp-append-version="true"></script>
}

<section class="team-section">
    <div class="team-intro">
        <h1>@Content.Get("TheTeam:Sections:0:TextContent:0:Heading")</h1>
        <p>@Content.Get("TheTeam:Sections:0:TextContent:0:Paragraph")</p>
    </div>

    <div class="team-card-grid">
        @{
            int i = 1; // start after the intro
            while (true)
            {
                var heading = Content.Get($"TheTeam:Sections:0:TextContent:{i}:Heading");
                var paragraph = Content.Get($"TheTeam:Sections:0:TextContent:{i}:Paragraph");

                if (string.IsNullOrWhiteSpace(paragraph))
                {
                    break; // stop loop if no more team members
                }

                // Split job title from description
                var parts = paragraph.Split(" — ", 2);
                var jobTitle = parts.Length > 1 ? parts[0] : "";
                var description = parts.Length > 1 ? parts[1] : paragraph;

                // Output HTML inside the code block
                <div class="team-card">
                    <h3>@heading</h3>
                    <p class="job-title">@jobTitle</p>
                    <p>@description</p>
                </div>

                i++; // move to next member
            }
        }
    </div>
</section>
