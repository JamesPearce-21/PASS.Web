@{
    ViewData["Title"] = "Training";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Training.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/cpd.js" asp-append-version="true"></script>
}

<section class="cpd-section">
    <div class="cpd-intro">
        <h1>CPD & Training</h1>
        <p>PASS offers a wide range of continuous professional development (CPD) courses and workshops designed to upskill staff and build confidence in delivering high-quality PE lessons.</p>
        <p>Our training programmes cater to a variety of roles, including specific courses for PE subject leads, school governors, and staff involved in playtime activities and extracurricular opportunities. These sessions ensure that all staff are equipped to enhance the PE experience and contribute to the physical development of pupils.</p>
        <p>Along with central venues and virtual workshops, PASS also offers a bespoke service whereby schools can receive tailored support through full day, half day, or twilight staff sessions—delivered in the comfort of your own school hall.</p>
    </div>

    <div class="cpd-download">
        <a href="/downloads/CPD-List-2025-26.pdf" class="cpd-btn" target="_blank">Download CPD List 2025–26</a>
    </div>
</section>