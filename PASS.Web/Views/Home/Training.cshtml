@{
    ViewData["Title"] = "Training";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Training.css" asp-append-version="true" />
}

@inject PASS.Web.Services.ContentService Content

@section Scripts {
    <script src="~/js/cpd.js" asp-append-version="true"></script>
    <script>
        const today = new Date();
        let yearStart = today.getFullYear();
        const month = today.getMonth(); // 0 = Jan, 8 = Sep

        // If it's September or later, increment to next academic year
        if (month >= 8) {
            yearStart = yearStart;
            var yearEnd = yearStart + 1;
        } else {
            yearStart = yearStart - 1;
            var yearEnd = yearStart + 1;
        }

        const link = document.getElementById('cpd-link');
        link.href = `@Content.Get("Training:Sections:0:DownloadableContent:0:Src")`;
        link.textContent = `Download CPD List ${yearStart}-${yearEnd}`;
    </script>
}

<section class="cpd-section">
    <div>
        <div>
            <img src="@Content.Get("Training:Sections:0:ImageContent:0:Src")"
                 alt="@Content.Get("Training:Sections:0:ImageContent:0:Alt")">
        </div>
    </div>

    <div class="cpd-intro">
        <h1>@Content.Get("Training:Sections:0:TextContent:0:Heading")</h1>
        <p>@Content.Get("Training:Sections:0:TextContent:1:Paragraph")</p>
        <p>@Content.Get("Training:Sections:0:TextContent:2:Paragraph")</p>
        <p>@Content.Get("Training:Sections:0:TextContent:3:Paragraph")</p>
        <p>@Content.Get("Training:Sections:0:TextContent:4:Paragraph")</p>
    </div>

    <div>
        <div>
            <img src="@Content.Get("Training:Sections:0:ImageContent:1:Src")"
                 alt="@Content.Get("Training:Sections:0:ImageContent:1:Alt")">
        </div>
    </div>

    <div class="cpd-download">
        <a id="cpd-link" href="#" class="cpd-btn">@Content.Get("Training:Sections:0:DownloadableContent:0:Alt")</a>
    </div>
</section>