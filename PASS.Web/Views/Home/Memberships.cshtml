@{
    ViewData["Title"] = "Memberships";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Memberships.css" asp-append-version="true" />
}

@inject PASS.Web.Services.ContentService Content

@section Scripts {
    <script src="~/js/memberships.js" asp-append-version="true"></script>
</section>}

<section class="memberships-section">
    <div class="memberships-intro">
        <h1>@Content.Get("Memberships:Sections:0:TextContent:0:Heading")</h1>
        <p>@Content.Get("Memberships:Sections:0:TextContent:1:Paragraph")</p>
        <p>@Content.Get("Memberships:Sections:0:TextContent:2:Paragraph")</p>
        <div class="membership-benefits">
            @foreach (var line in Content.Get("Memberships:Sections:0:TextContent:3:Paragraph").Split('\n'))
            {
                <p>@line</p>
            }
        </div>
        <p>@Content.Get("Memberships:Sections:0:TextContent:4:Paragraph")</p>
        <p>@Content.Get("Memberships:Sections:0:TextContent:5:Paragraph")</p>
    </div>

    <div class="membership-packages">
        @for (int i = 6; i <= 10; i++)
        {
            var heading = Content.Get($"Memberships:Sections:0:TextContent:{i}:Heading");
            var paragraph = Content.Get($"Memberships:Sections:0:TextContent:{i}:Paragraph");

            <div class="package-card">
                <img src="@Content.Get($"Memberships:Sections:0:ImageContent:{i-6}:Src")"
                     alt="@Content.Get($"Memberships:Sections:0:ImageContent:{i-6}:Alt")" class="logo">
                <h3>@heading</h3>
                <p class="package-description">@paragraph</p>
            </div>
        }
    </div>

    <div class="contact-info">
        <h3>@Content.Get("Memberships:Sections:0:TextContent:11:Heading")</h3>
        <p>@Content.Get("Memberships:Sections:0:TextContent:11:Paragraph")</p>
        <a href="mailto:info@passltd.org" class="contact-btn">Contact Us</a>
        <a href="@Content.Get("Memberships:Sections:0:DownloadableContent:0:Src")" class="contact-btn">
            @Content.Get("Memberships:Sections:0:DownloadableContent:0:Alt")
        </a>
    </div>
</section>
